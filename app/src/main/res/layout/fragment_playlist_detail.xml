<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistDetailLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="88dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/playlistTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Playlist Title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/expandedNowPlayingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/currentTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text=" "
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="italic" />

        <ImageView
            android:id="@+id/currentTrackImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_placeholder" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_mini_player_button"
                android:contentDescription="Previous"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_previous"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/buttonPlayPause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_mini_player_button"
                android:contentDescription="Play or pause"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/buttonNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_mini_player_button"
                android:contentDescription="Next"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_next"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/collapsedNowPlayingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/collapsedTrackImage"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/collapsedTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/collapsedPlayerControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/collapsedButtonPrev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:contentDescription="Previous"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_previous"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/collapsedButtonPlayPause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:contentDescription="Play or pause"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/collapsedButtonNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:contentDescription="Next"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_next"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistItemRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="100dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
