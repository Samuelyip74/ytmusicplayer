<?xml version="1.0" encoding="utf-8"?>
<resources>

        <style name="Theme.Ytmusicplayer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

                <!-- Splash screen settings -->
                <item name="android:windowSplashScreenBackground">@android:color/background_dark
                </item>
                <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
                <item name="android:windowSplashScreenIconBackgroundColor">
                        @android:color/background_dark
                </item>

                <!-- Primary brand color. -->
                <item name="colorPrimary">#FF0000</item>
                <item name="colorPrimaryVariant">#B30000</item>
                <item name="colorOnPrimary">@color/white</item>
                <!-- Secondary brand color. -->
                <item name="colorSecondary">@color/teal_200</item>
                <item name="colorSecondaryVariant">@color/teal_700</item>
                <item name="colorOnSecondary">@color/black</item>
                <!-- Status bar color. -->
                <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
                <!-- Customize your theme here. -->
        </style>
</resources>